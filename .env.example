# 学习助手 (Study assistant) - 环境配置
# 复制为 .env 后按需修改

# 服务
HOST=127.0.0.1
PORT=8000

# 数据目录（相对项目根）
DATA_DIR=backend/data

# 旧版 DeepSeek 环境变量兼容入口；2.0 推荐直接在设置页管理多供应商连接与任务路由
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-你的key
# 旧版默认档位；设置页中的任务路由优先于这里的兼容配置
DEEPSEEK_MODEL=flash

# 视觉分析（可选，Qwen-VL，阿里百炼 OpenAI 兼容接口；不填不影响本地功能）
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=sk-你的qwen-key
VISION_MODEL=qwen3-vl-plus

# 检索
RAG_TOP_K=5
VECTOR_SEARCH=false   # 可选，默认关闭（FTS5 关键词检索零内存）

# 文档解析（默认轻量；可选 PP-DocLayout-M 使用独立 ONNX 子进程）
PDF_TEXT_BACKEND=pdftext
LAYOUT_BACKEND=font
OCR_PAGE_THRESHOLD=30
OCR_PAGE_TIMEOUT_SECONDS=180
# LAYOUT_BACKEND=pp-doclayout-m 时可指向独立环境；不填则尝试 .pp-doclayout-venv
# PP_DOCLAYOUT_PYTHON=D:\path\to\.pp-doclayout-venv\Scripts\python.exe
PP_DOCLAYOUT_CPU_THREADS=2
PP_DOCLAYOUT_IMAGE_SIZE=960
