# 保研复习助手 - 环境配置
# 复制为 .env 后按需修改

# 服务
HOST=127.0.0.1
PORT=8000

# 数据目录（相对项目根）
DATA_DIR=backend/data

# LLM 默认模式: local / cloud
LLM_MODE=local

# 本地 Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# 云端 DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# 检索
RAG_TOP_K=5
VECTOR_SEARCH=false   # P1 可选，默认关闭（FTS5 关键词检索零内存）

# 卡片
DAILY_NEW_CARDS=20
