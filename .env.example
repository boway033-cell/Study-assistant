# 学习助手 (Study assistant) - 环境配置
# 复制为 .env 后按需修改

# 服务
HOST=127.0.0.1
PORT=8000

# 数据目录（相对项目根）
DATA_DIR=backend/data

# DeepSeek 云端 AI（本地 AI 部署已取消，仅云端）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-你的key
# 模型档位: flash=deepseek-v4-flash(快) / pro=deepseek-v4-pro(深度推理)
DEEPSEEK_MODEL=flash

# 视觉分析（可选，Qwen-VL，阿里百炼 OpenAI 兼容接口；不填不影响本地功能）
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=sk-你的qwen-key
VISION_MODEL=qwen3-vl-plus

# 检索
RAG_TOP_K=5
VECTOR_SEARCH=false   # 可选，默认关闭（FTS5 关键词检索零内存）
