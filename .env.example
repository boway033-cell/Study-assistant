# 学习助手 (Study assistant) - 环境配置
# 复制为 .env 后按需修改

# 服务
HOST=127.0.0.1
PORT=8000

# 数据目录（相对项目根）
DATA_DIR=backend/data

# 旧版 DeepSeek 环境变量兼容入口；2.0 推荐直接在设置页管理多供应商连接与任务路由
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-你的key
# 旧版默认档位；设置页中的任务路由优先于这里的兼容配置
DEEPSEEK_MODEL=flash

# 视觉分析（可选，Qwen-VL，阿里百炼 OpenAI 兼容接口；不填不影响本地功能）
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=sk-你的qwen-key
VISION_MODEL=qwen3-vl-plus

# 检索
RAG_TOP_K=5
VECTOR_SEARCH=false   # 可选，默认关闭（FTS5 关键词检索零内存）

# 文档解析（默认轻量；可选 PP-DocLayout-M 使用独立 ONNX 子进程）
PDF_TEXT_BACKEND=pdftext
LAYOUT_BACKEND=font
OCR_PAGE_THRESHOLD=30
OCR_PAGE_TIMEOUT_SECONDS=180
OCR_RENDER_DPI=144
OCR_LARGE_DOCUMENT_DPI=120
OCR_USE_ANGLE_CLS=false
# OCR 第一阶段：模型延迟释放（0=任务结束立即释放）、空白页跳过与性能统计
OCR_ENGINE_IDLE_SECONDS=300
OCR_SKIP_BLANK_PAGES=true
# 非白像素比例阈值，超过则执行完整 OCR；调大只会更激进地跳过疑似空白页
OCR_BLANK_PAGE_THRESHOLD=0.008
OCR_METRICS_ENABLED=true
# OCR 第二阶段：有限并发流水线（OCR_WORKERS=1 回退单页串行路径）
OCR_WORKERS=2
OCR_RENDER_AHEAD=3
OCR_MAX_IMAGE_QUEUE=4
# 每个 ONNX 实例内部线程数上限；当前捆绑的 rapidocr 版本不支持时会自动忽略
OCR_ONNX_INTRA_THREADS=6
OCR_ONNX_INTER_THREADS=1
# 单页失败后继续处理剩余页面（失败页不写缓存，下次重跑自动补识别）
OCR_CONTINUE_ON_PAGE_ERROR=true
# LAYOUT_BACKEND=pp-doclayout-m 时可指向独立环境；不填则尝试 .pp-doclayout-venv
# PP_DOCLAYOUT_PYTHON=D:\path\to\.pp-doclayout-venv\Scripts\python.exe
PP_DOCLAYOUT_CPU_THREADS=2
PP_DOCLAYOUT_IMAGE_SIZE=960
