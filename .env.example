# 保研复习助手 - 环境配置
# 复制为 .env 后按需修改

# 服务
HOST=127.0.0.1
PORT=8000

# 数据目录（相对项目根）
DATA_DIR=backend/data

# DeepSeek 云端 AI（本地 AI 部署已取消，仅云端）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-你的key
# 模型档位: flash=deepseek-chat(快) / pro=deepseek-reasoner(深度推理)
DEEPSEEK_MODEL=flash

# 检索
RAG_TOP_K=5
VECTOR_SEARCH=false   # P1 可选，默认关闭（FTS5 关键词检索零内存）
